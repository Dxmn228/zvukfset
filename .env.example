# Copy to .env and fill in private values. Never commit .env.
# Use single quotes around secret values containing $ for Docker Compose.
POSTGRES_DB=zvukfest_db
POSTGRES_USER=zvuk_user
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=

# Optional overrides for local commands (Docker sets DB_HOST=db).
# DB_HOST=localhost
# DB_PORT=5432
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],zvukfest.de3.netrun.io
DJANGO_CSRF_TRUSTED_ORIGINS=https://zvukfest.de3.netrun.io

# Optional initial admin. Set these in hosting Secrets, never in Git.
# Use a new email and a unique password of at least 12 characters.
# Remove all three secrets after successful admin login.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_NAME=
DJANGO_SUPERUSER_PASSWORD=
